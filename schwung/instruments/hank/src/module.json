{
  "id": "hank",
  "name": "Hank",
  "abbrev": "HK",
  "version": "0.6.0",
  "description": "Two-operator FM on eight knobs, one page: ratio, brightness, bite, one envelope pair, noise and a tone sweep. 32 presets.",
  "author": "charlesvestal",
  "license": "MIT",
  "component_type": "sound_generator",
  "api_version": 2,
  "min_host_version": "1.2.0",
