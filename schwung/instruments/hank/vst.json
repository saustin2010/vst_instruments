{
  "name": "[SYN] Hank",
  "vendor": "Charles Vestal",
  "uid": "Hank",
  "programs": {"param": "preset", "name": "preset_name", "count": "preset_count"},
  "so": "hank.so",
  "module": "src/module.json",
  "build": {
    "sources": [
      "src/dsp/hank_plugin.cpp",
      "src/dsp/hank_engine.cpp"
    ],
    "cflags": [
      "-Isrc/dsp",
      "-std=gnu++14", "-DMPC_PORT"
    ],
    "libs": [
      "-lm"
    ]
  },
  "params": "params.json",
  "layout": "layout.conf",
  "art": "html",
  "defines": {"QLINK_TRAVEL": 1, "SET_IF_CHANGED": 1}
}
