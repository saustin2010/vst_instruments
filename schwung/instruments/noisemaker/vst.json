{
  "name": "[SYN] Noisemaker",
  "vendor": "TAL",
  "uid": "Nois",
  "programs": {"param": "preset", "name": "preset_name", "count": "preset_count", "name_at": "preset_name_at"},
  "so": "noisemaker.so",
  "module": "src/module.json",
  "params": "params.json",
  "build": {
    "sources": [
      "src/dsp/noisemaker_plugin.cpp",
      "src/dsp/Engine/Lfo.cpp"
    ],
    "cflags": [
      "-Isrc",
      "-Isrc/dsp",
      "-Isrc/dsp/Engine",
      "-std=gnu++14",
      "-fpermissive", "-DMPC_PORT", "-fwrapv",
      "-Wno-write-strings"
    ],
    "libs": [
      "-lm"
    ]
  },
  "layout": "layout.conf",
  "art": "html",
  "defines": {
    "QLINK_TRAVEL": 1, "SET_IF_CHANGED": 1,
    "MODULE_DIR": "\"/sdcard/vst/noisemaker\"",
    "MODULE_SUBDIR": "\"noisemaker\""
  }
}
