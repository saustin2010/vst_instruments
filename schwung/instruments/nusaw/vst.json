{
  "name": "NuSaw",
  "vendor": "Charles Vestal",
  "uid": "NuSw",
  "programs": {"param": "preset", "name": "preset_name", "count": "preset_count"},
  "so": "nusaw.so",
  "module": "src/module.json",
  "build": {
    "sources": [
      "src/dsp/nusaw_plugin.cpp",
      "src/dsp/nusaw_engine.cpp"
    ],
    "cflags": [
      "-Isrc/dsp",
      "-std=c++14"
    ],
    "libs": [
      "-lm"
    ]
  },
  "params": "params.json",
  "layout": "layout.conf",
  "art": "html"
}
