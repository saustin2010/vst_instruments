{
  "name": "[SYN] Hera",
  "vendor": "jpcima",
  "uid": "Hera",
  "programs": {"param": "preset", "name": "preset_name", "count": "preset_count", "name_at": "preset"},
  "so": "hera.so",
  "module": "src/module.json",
  "build": {
    "sources": [
      "src/dsp/hera_plugin.cpp",
      "src/dsp/Engine/HeraEnvelope.cpp",
      "src/dsp/Engine/HeraLFO.cpp",
      "src/dsp/Engine/HeraLFOWithEnvelope.cpp",
      "src/dsp/Engine/HeraTables.cpp",
      "src/dsp/Engine/bbd_filter.cpp",
      "src/dsp/Engine/bbd_line.cpp"
    ],
    "cflags": [
      "-Isrc/dsp",
      "-Isrc/dsp/Engine",
      "-std=gnu++14", "-fwrapv",
      "-DMPC_PORT"
    ],
    "libs": [
      "-lm"
    ]
  },
  "params": "params.json",
  "layout": "layout.conf",
  "art": "html",
  "defines": {
    "QLINK_TRAVEL": 1, "SET_IF_CHANGED": 1,
    "MODULE_DIR": "\"/sdcard/vst/hera\"",
    "MODULE_SUBDIR": "\"hera\""
  }
}
