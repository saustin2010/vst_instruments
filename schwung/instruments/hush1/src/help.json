{
  "title": "HUSH ONE",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Monophonic synth",
        "emulating the",
        "Roland SH-101.",
        "",
        "Saw, pulse (PWM),",
        "sub-oscillator, and",
        "noise. 4-pole LP",
        "filter with envelope",
        "and LFO modulation.",
        "",
        "Last-note or lowest-",
        "note priority with",
        "glide/portamento.",
        "",
        "11 built-in presets.",
        "Imports TAL-BassLine",
        ".vstpreset files."
      ]
    },
    {
      "title": "Controls",
      "children": [
        {
          "title": "Knob Mapping",
          "lines": [
            "Main page knobs:",
            " 1 Cutoff",
            " 2 Resonance",
            " 3 Env Amt",
            " 4 Attack",
            " 5 Decay",
            " 6 Sustain",
            " 7 Release",
            " 8 Volume",
            "",
            "Each submenu below",
            "has its own four",
            "knobs; any extra",
            "params follow on",
            "later pages."
          ]
        },
        {
          "title": "Oscillator",
          "lines": [
            "Knobs: Saw, Pulse,",
            "Sub, Noise.",
            "",
            "Saw: sawtooth level",
            "Pulse: pulse level",
            "Sub: sub-osc level",
            "Noise: noise level",
            "White Noise: Off/On",
            " (extra white noise",
            "  layer)",
            "",
            "Sub Mode:",
            " -2 Oct 50% PW",
            " -2 Oct",
            " -1 Oct",
            "",
            "Pulse Width:",
            " 0.05-0.95",
            " (0.5 = square)",
            "",
            "PWM Mode:",
            " Env: filter env",
            " Manual: fixed PW",
            " LFO: LFO modulates",
            "",
            "PWM Depth: LFO amt",
            "PWM Env Depth: env",
            " amt, Env mode only"
          ]
        },
        {
          "title": "Filter",
          "lines": [
            "4-pole lowpass.",
            "Knobs: Cutoff,",
            "Resonance, Env Amt,",
            "Key Follow.",
            "",
            "Cutoff: frequency",
            "Resonance: 0-1.2",
            " (>1.0 self-osc)",
            "Env Amt: filter",
            " envelope depth",
            "Key Follow: keyboard",
            " tracking",
            "",
            "Velocity Sens:",
            " velocity to cutoff",
            "",
            "Env Polarity and",
            "Full Range live on",
            "the Advanced page."
          ]
        },
        {
          "title": "Envelopes",
          "lines": [
            "Two ADSR envelopes,",
            "each with its own",
            "four knobs.",
            "",
            "Amp Envelope:",
            " Attack: 1ms-4s",
            " Decay: 1ms-6s",
            " Sustain: 0-100%",
            " Release: 1ms-8s",
            "",
            "Filter Envelope:",
            " F.Attack: 1ms-4s",
            " F.Decay: 1ms-6s",
            " F.Sustain: 0-100%",
            " F.Release: 1ms-8s",
            "",
            "Velocity Sens: 0-1,",
            " velocity to level.",
            " The Off/Trigger/",
            " Active mode is on",
            " the Advanced page."
          ]
        },
        {
          "title": "LFO",
          "lines": [
            "Knobs: Rate, Pitch,",
            "Filter, PWM.",
            "",
            "Rate: 0.02-40 Hz",
            "",
            "Waveform:",
            " Tri, Rect, Random,",
            " Noise (S&H)",
            "",
            "Trigger:",
            " Free or Retrigger",
            "",
            "Sync: Free, or Sync",
            " to snap the rate to",
            " a fixed table",
            " (0.125-32 Hz)",
            "",
            "Destinations:",
            " Pitch: vibrato",
            " Filter: wah",
            " PWM: pulse width",
            "",
            "Invert: flip",
            " polarity",
            "Pitch Snap: lock",
            " to semitones"
          ]
        },
        {
          "title": "Performance",
          "lines": [
            "Knobs: Glide,",
            "Portamento Mode,",
            "Transpose, Octave.",
            "",
            "Glide: 0-500ms",
            "",
            "Portamento Mode:",
            " Off: no glide",
            " On: always glide",
            " Auto: legato only",
            "",
            "Portamento Curve:",
            " Expo (musical) or",
            " Linear",
            "",
            "Retrigger:",
            " Legato: no retrig",
            "  on held notes",
            " Trig: always",
            "  retrigger envelope",
            "",
            "Hold: sustain notes",
            "",
            "Transpose:",
            " -24 to +24",
            " semitones",
            "Octave: -2 to +2",
            " (sets Transpose",
            "  in whole octaves)",
            "Fine Tune:",
            " -100 to +100 cents"
          ]
        },
        {
          "title": "Advanced",
          "lines": [
            "Knobs: Gate Trig",
            "Mode, Priority,",
            "Velocity Sens,",
            "Same Note Quirk.",
            "",
            "Gate Trig Mode:",
            " Gate: retrig only",
            "  per Retrigger",
            " Gate+Trig: retrig",
            "  on every note",
            " LFO: the LFO gates",
            "  the VCA",
            "",
            "VCA Mode:",
            " Envelope (amp env)",
            " Gate (on/off)",
            "",
            "ADSR Declick: 0-1,",
            " softens envelope",
            " resets",
            "",
            "Priority: Last/Low",
            "",
            "Velocity Sens:",
            " Off, Trigger, or",
            " Active",
            "",
            "Same Note Quirk:",
            " Off/On. In Gate+",
            " Trig, a repeated",
            " note does not",
            " retrigger.",
            "",
            "Full Range: doubles",
            " the filter env",
            " depth. Positive",
            " polarity only;",
            " cutoff still spans",
            " 20 Hz-18 kHz.",
            "",
            "Env Polarity:",
            " Positive or",
            " Negative (invert)",
            "",
            "Filter Volume Corr:",
            " 0-1, adds level",
            " back at high",
            " resonance."
          ]
        }
      ]
    },
    {
      "title": "MIDI",
      "lines": [
        "Monophonic. Held",
        "notes are tracked in",
        "a 16-entry stack.",
        "",
        "Pitch Bend:",
        " 0-12 semitones",
        " (configurable)",
        "",
        "Mod Wheel (CC 1):",
        " scales all three",
        " LFO depths - pitch,",
        " filter and PWM.",
        "",
        "CC 123: All Notes Off"
      ]
    },
    {
      "title": "Presets",
      "lines": [
        "11 built-in presets:",
        "",
        " Init",
        " Classic 101 Sub",
        " Acid-ish Square",
        " Hollow PWM Lead",
        " Laser Zap",
        " Resonant Pluck",
        " Self-Osc Sine Lead",
        " Noisy Snare Hit",
        " Portamento Lead",
        " Arp Pluck Clocked",
        " Random Filter",
        "",
        "Upload .vstpreset",
        "files (TAL-BassLine)",
        "to presets/ folder."
      ]
    }
  ]
}
