{
  "title": "Chordism",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Chord-based",
        "polyphonic synth.",
        "",
        "One note in,",
        "4 voices out,",
        "with morphing",
        "level/pan and",
        "stereo filter.",
        "",
        "Last-note mono.",
        "Press pad -> chord.",
        "Pressure opens",
        "the filter."
      ]
    },
    {
      "title": "Quick Start",
      "lines": [
        "1. Pick a preset",
        "from the root",
        "level list.",
        "",
        "2. Hold a pad.",
        "Hear the chord.",
        "",
        "3. Press pad",
        "harder -> filter",
        "opens.",
        "",
        "4. Sweep the",
        "Cutoff knob on",
        "root level.",
        "",
        "5. Try the Chord",
        "knob to change",
        "voicing."
      ]
    },
    {
      "title": "Oscillators",
      "lines": [
        "4 voices arranged",
        "as chord steps.",
        "Each step has its",
        "own waveform.",
        "",
        "Waves: Off, Sine,",
        "Triangle, Saw,",
        "Square, Pulse Tr,",
        "Wavetable.",
        "",
        "Shape morphs the",
        "current wave:",
        "sine wavefolds,",
        "tri tilts,",
        "saw octave-morph,",
        "square PWM,",
        "pulse PWM,",
        "wavetable scans.",
        "",
        "FM matrix: pick",
        "one osc as the",
        "modulator. The",
        "others' phase is",
        "shifted by it."
      ]
    },
    {
      "title": "Chord / Tuning",
      "lines": [
        "Chord: 16 types",
        "(Octaves, Fifth,",
        "Min, Min7..11,",
        "Maj, Maj7..9,",
        "Sus 4, 6/9, etc.)",
        "",
        "Spread scales",
        "intervals.",
        "",
        "Rotation shifts",
        "which voice plays",
        "which interval.",
        "",
        "Detune: cents",
        "offset across",
        "voices.",
        "",
        "Tuning modes:",
        "Chord (LUT),",
        "Interval (user",
        "intervals 1/2/3),",
        "Chord Multi",
        "(per pitch class)."
      ]
    },
    {
      "title": "Scale Quantizer",
      "lines": [
        "25 scales snap",
        "chord notes to",
        "scale degrees.",
        "",
        "Chromatic = off.",
        "Pick a scale and",
        "root.",
        "",
        "A C-major chord",
        "through C-minor",
        "scale becomes",
        "C minor."
      ]
    },
    {
      "title": "Filter",
      "lines": [
        "TPT SVF, dual",
        "stage (stereo).",
        "",
        "Modes: LP, HP, BP.",
        "Slopes: 12 dB or",
        "24 dB (cascaded).",
        "",
        "Cutoff, Reso.",
        "",
        "With Ctrl Src on",
        "Aftertouch and",
        "its to Cutoff",
        "amount at 0 (the",
        "default), press",
        "opens cutoff by",
        "up to +0.4. Set",
        "a to Cutoff",
        "amount and that",
        "replaces it.",
        "",
        "Filter Env: AD,",
        "ASR, or Looping",
        "modes + depth.",
        "",
        "Filter LFO: 4",
        "shapes, rate,",
        "depth, stereo",
        "spread for L/R",
        "phase offset.",
        "",
        "Drive: tanh soft",
        "clip. Bypassed",
        "when 0."
      ]
    },
    {
      "title": "Morph",
      "lines": [
        "Level Morph:",
        "16-row LUT of",
        "voice gain mixes.",
        "Index sweeps,",
        "Intensity blends",
        "flat -> row.",
        "",
        "Pan Morph: 16",
        "rows of stereo",
        "positions.",
        "",
        "Both have their",
        "own LFO (rate,",
        "depth, shape)",
        "for animation."
      ]
    },
    {
      "title": "Modulation",
      "lines": [
        "Shape LFO: 4",
        "shapes, rate,",
        "depth.",
        "Per-osc phase",
        "offsets give",
        "independent",
        "shape motion.",
        "",
        "Vibrato: speed,",
        "depth, delay",
        "ramp. Stray mode",
        "for analog drift.",
        "Per-osc enable.",
        "",
        "Pitch Sweep:",
        "amount +/-12 semis",
        "on note onset,",
        "exp decay rate.",
        "Per-osc enable.",
        "",
        "Glide: portamento",
        "between chords.",
        "Legato mode only",
        "glides when notes",
        "overlap."
      ]
    },
    {
      "title": "Envelope",
      "lines": [
        "VCA env modes:",
        "AD (auto decay),",
        "ASR (sustain on",
        "gate, release on",
        "release - legacy),",
        "Looping (cycles",
        "A-D while held).",
        "",
        "Hard Reset: when",
        "on, env value",
        "snaps to 0 on",
        "retrigger.",
        "",
        "Drone: bypasses",
        "VCA env. Voices",
        "stay open."
      ]
    },
    {
      "title": "Arpeggiator",
      "lines": [
        "Cycles held notes.",
        "Directions: Up,",
        "Down, Up/Down,",
        "Random.",
        "",
        "Hold latches",
        "held notes when",
        "you release.",
        "",
        "Euclidean: set",
        "Steps + Beats.",
        "Pattern fires",
        "only on euclid",
        "step positions.",
        "",
        "Variation:",
        "interval + count",
        "transposes the",
        "pattern over",
        "successive cycles.",
        "",
        "Clock: Internal",
        "or MIDI Clock",
        "(F8) with",
        "divisions 1/4..",
        "1/32."
      ]
    },
    {
      "title": "Effects",
      "lines": [
        "Reverb: Dattorro",
        "plate (modulated",
        "tank).",
        "",
        "Mix, Decay, Damp,",
        "Shimmer (chorus",
        "depth), Low Cut",
        "(HP on wet),",
        "Size (tail",
        "length), Mod",
        "Rate/Depth (extra",
        "chorus).",
        "",
        "Delay modes:",
        "Stereo, Ping-Pong,",
        "Flip-Flop, Long",
        "(mono), Zenith",
        "(+1 oct repeats),",
        "Interval (pitch",
        "shift).",
        "",
        "Time, Feedback,",
        "Tone Hi/Lo,",
        "Mod Rate/Depth.",
        "",
        "Lo-Fi: Grind",
        "(bit reduction),",
        "Shift (DC bias",
        "for staircase),",
        "Decimator (sample",
        "rate hold).",
        "Position toggle",
        "pre or post",
        "filter."
      ]
    },
    {
      "title": "Mod Source",
      "lines": [
        "One global",
        "control source",
        "routed to many",
        "targets.",
        "",
        "Sources: After-",
        "touch (continuous",
        "pressure), Random",
        "(new value per",
        "note), Coin Toss",
        "(+/-1 per note),",
        "MIDI CC (pick the",
        "CC number),",
        "Velocity.",
        "",
        "Routings to:",
        "Cutoff, Morph,",
        "Vib Depth, Shape,",
        "FM amount.",
        "",
        "Each routing is",
        "bipolar (-1..+1).",
        "",
        "If the source is",
        "Aftertouch and",
        "to Cutoff is 0,",
        "a default press",
        "-to-cutoff of",
        "+0.4 is added.",
        "Any non-zero to",
        "Cutoff replaces",
        "it."
      ]
    },
    {
      "title": "Presets",
      "lines": [
        "57 built-in",
        "presets.",
        "",
        "Highlights:",
        "Lush Pad - wide",
        "saw pad.",
        "FM Bell - bell",
        "with FM.",
        "Acid Lead - 303",
        "squelch.",
        "Sub Bass - sine",
        "sub.",
        "Underwater - pan-",
        "morph + flip-flop",
        "delay.",
        "Trance Arp - arp",
        "+ filter env.",
        "Phrygian Pad -",
        "scale + animated",
        "morphs.",
        "Cosmic Sweep -",
        "everything-on",
        "showpiece.",
        "Coin Toss Lead -",
        "shape randomizer.",
        "Aftertouch Wow -",
        "press hard for",
        "filter open."
      ]
    },
    {
      "title": "License",
      "lines": [
        "MIT.",
        "",
        "Source code at",
        "github.com /",
        "charlesvestal /",
        "schwung-chordism."
      ]
    }
  ]
}
