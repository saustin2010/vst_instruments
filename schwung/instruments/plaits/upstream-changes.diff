--- a/src/dsp/plaits/dsp/engine2/six_op_engine.cc
+++ b/src/dsp/plaits/dsp/engine2/six_op_engine.cc
@@ -79,7 +79,15 @@
   for (int i = 0; i < kNumSixOpVoices; ++i) {
     voice_[i].Init(&algorithms_, kCorrectedSampleRate);
   }
+#ifdef MPC_PORT
+  // MPC port (2026-10-02): fm::Voice<6>::Render(params, temp, size) uses temp, temp + size and temp + 2 * size, so
+  // the scratch needs 3 * kMaxBlockSize; with one block it wrote 48 floats into patches_, allocated right after it,
+  // and FM patches 0-1 of the bank played garbage operator data (out-of-range table reads; found with
+  // steve/tools/fuzz). Four blocks, to leave a spare.
+  temp_buffer_ = allocator->Allocate<float>(kMaxBlockSize * 4);
+#else
   temp_buffer_ = allocator->Allocate<float>(kMaxBlockSize);
+#endif
   patches_ = allocator->Allocate<fm::Patch>(kNumPatchesPerBank);
 }
 
--- a/src/dsp/stmlib/dsp/dsp.h
+++ b/src/dsp/stmlib/dsp/dsp.h
@@ -42,7 +42,19 @@
 
 inline float Interpolate(const float* table, float index, float size) {
   index *= size;
+#ifdef MPC_PORT
+  // MPC port (2026-10-02): the hardware's ADCs stop just short of full scale, but a host parameter at exactly 1.0, or a
+  // modulation sum past it, read one past the end of the table (size + 1 entries; found with steve/tools/fuzz).
+  if (!(index > 0.0f)) index = 0.0f;  // also NaN
+  if (index > size) index = size;
   MAKE_INTEGRAL_FRACTIONAL(index)
+  if (index_integral >= static_cast<int32_t>(size)) {
+    index_integral = static_cast<int32_t>(size) - 1;
+    index_fractional = index - static_cast<float>(index_integral);
+  }
+#else
+  MAKE_INTEGRAL_FRACTIONAL(index)
+#endif
   float a = table[index_integral];
   float b = table[index_integral + 1];
   return a + (b - a) * index_fractional;
