+/* scope.h -- the scope's window on a plugin's own output, shared by vst2_wrap.c (vst.json "scope") and the offline
+ * shape-bank builder, so both cut the sound up the same way.
+ *
+ * The output goes into a ring of the last SCOPE_RING samples. A window is taken the way a scope triggers: the period
+ * is measured between two rising zero crossings (with hysteresis), then two periods are taken from the latest rising
+ * crossing that still fits, resampled to SCOPE_PTS points and scaled to their own peak (so a shape is compared by
+ * its form, not its level). Silence (peak under SCOPE_QUIET) has no window. */
+#ifndef MPC_SCOPE_H
+#define MPC_SCOPE_H
+#include <math.h>
+
+#define SCOPE_RING 4096   /* ~93 ms at 44.1 kHz; a power of two */
+#define SCOPE_PTS 128
+#define SCOPE_QUIET 0.003f
+
+static inline int scope_window(const float *ring, unsigned pos, float out[SCOPE_PTS]) {
+#define SR(k) ring[(pos + (unsigned)(k)) & (SCOPE_RING - 1)]   /* k = 0: the oldest sample */
+    float pk = 0;
+    for (int k = SCOPE_RING / 2; k < SCOPE_RING; k++) { float a = fabsf(SR(k)); if (a > pk) pk = a; }
+    if (pk < SCOPE_QUIET) return 0;
+    float h = 0.08f * pk;
+    int armed = 0, t0 = -1, t1 = -1;
+    for (int k = 0; k < SCOPE_RING && t1 < 0; k++) {
+        float v = SR(k);
+        if (v < -h) armed = 1;
+        else if (armed && v > h) { if (t0 < 0) t0 = k; else t1 = k; armed = 0; }
+    }
+    int win = t1 > t0 && t0 >= 0 ? 2 * (t1 - t0) : 1024;
+    if (win < 64) win = 64;
+    if (win > SCOPE_RING / 2) win = SCOPE_RING / 2;
+    int start = SCOPE_RING - win;
+    armed = 0;
+    for (int k = 0; k + win <= SCOPE_RING; k++) {
+        float v = SR(k);
+        if (v < -h) armed = 1;
+        else if (armed && v > h) { start = k; armed = 0; }
+    }
+    float wp = 1e-9f;
+    for (int c = 0; c < SCOPE_PTS; c++) {
+        float x = start + (c + 0.5f) * win / SCOPE_PTS;
+        int i = (int)x;
+        float f = x - i, v = SR(i) + f * (SR(i + 1) - SR(i));
+        out[c] = v;
+        if (fabsf(v) > wp) wp = fabsf(v);
+    }
+    for (int c = 0; c < SCOPE_PTS; c++) out[c] /= wp;
+#undef SR
+    return 1;
+}
+
+#endif
